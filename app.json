{
  "expo": {
    "name": "DevJournal",
    "slug": "devjournal",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "devjournal",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0e11"
    },
    "assetBundlePatterns": [
      "**/*",
      "assets/models/nsfw/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devjournal.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "UIBackgroundModes": [
          "processing"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0e0e11"
      },
      "package": "com.devjournal.app",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-splash-screen",
      "expo-sqlite",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7106899968085818~5951781354",
          "iosAppId": "ca-app-pub-7106899968085818~5951781354",
          "android_app_id": "ca-app-pub-7106899968085818~5951781354",
          "ios_app_id": "ca-app-pub-7106899968085818~5951781354"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "418ed3bb-acdb-49ec-9f95-d5e806d4886f"
      }
    },
    "owner": "aamir_girach"
  }
}
